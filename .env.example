PORT=5000
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
SESSION_SECRET=a_long_random_string
# Public URL of the app. In development this is the Vite dev server.
APP_URL=http://localhost:5173
NODE_ENV=development

# Database. Leave DATABASE_URL empty to use a local SQLite file (DATABASE_PATH).
# Set it to a Postgres connection string (e.g. from Neon) to use Postgres instead.
DATABASE_URL=
DATABASE_PATH=./gitseek.db

# Optional: a fine-grained GitHub token (public repositories read-only, no
# permissions, with an expiry) for searches by visitors who are not logged in.
# Set it in Render's environment variables in production; see the README.
GITHUB_TOKEN=
